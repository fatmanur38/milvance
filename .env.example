# ============================================================================
# Milvance environment contract (AGENT.md §31)
# Copy to .env and fill in. NEVER commit a real .env.
# Server secrets must never be exposed to the frontend.
# ============================================================================

NODE_ENV=development
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
DATABASE_URL=postgresql://milvance:milvance@localhost:5432/milvance
PORT=3001
INDEXER_START_LEDGER=4760607
INDEXER_POLL_SECONDS=10

# --- Stellar / Soroban: the financial source of truth ---
STELLAR_NETWORK=testnet
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
MILVANCE_CONTRACT_ID=CCN6AZHLN2BQPCDZWXJGA3NRJEJ56V5JK3M4VZ5QFKQ3NSJBN6RVTKRX
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
USDC_ASSET_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA

# --- Anchor / local payments (PKG-07). Anchor is the local-money edge, not a settings page. ---
ANCHOR_HOME_DOMAIN=tr-mock-anchor.fly.dev
ANCHOR_MOCK_MODE=true
# Used to encrypt short-lived SEP-10 session material at rest. Never log a JWT.
ANCHOR_SESSION_ENCRYPTION_KEY=

# --- Evidence object storage (PKG-08). Raw documents stay off-chain; only SHA-256 goes on-chain. ---
EVIDENCE_STORAGE_DRIVER=local-dev
EVIDENCE_LOCAL_DIR=.evidence-store
EVIDENCE_MAX_BYTES=26214400
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# --- Public traction dashboard (PKG-11) ---
PUBLIC_METRICS_ENABLED=true

# --- Frontend-safe values only (NEXT_PUBLIC_* is shipped to the browser) ---
# The browser talks to the Anchor directly, so the home domain must be readable
# here. Every endpoint is discovered from its stellar.toml at runtime.
NEXT_PUBLIC_ANCHOR_HOME_DOMAIN=tr-mock-anchor.fly.dev
# Sandbox bank-transfer simulator. Leave unset/false for anything but the
# hackathon sandbox: a production Anchor has no such endpoint.
NEXT_PUBLIC_ANCHOR_MOCK_MODE=true
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_MILVANCE_CONTRACT_ID=CCN6AZHLN2BQPCDZWXJGA3NRJEJ56V5JK3M4VZ5QFKQ3NSJBN6RVTKRX
