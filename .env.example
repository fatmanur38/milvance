# ============================================================================
# Milvance environment contract (AGENT.md §31)
# Copy to .env and fill in. NEVER commit a real .env.
# Server secrets must never be exposed to the frontend.
# ============================================================================

NODE_ENV=development
# Browser origin(s) allowed to call the API. Comma-separated for a preview
# deployment alongside production. A wildcard is never accepted.
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
# Local development. In the free hackathon deployment this is Supabase's
# Session pooler string, COPIED from Supabase → Connect → Session pooler — the
# host and format differ per project and must never be guessed. It carries a
# password, so it is never logged and never committed with a real value.
DATABASE_URL=postgresql://milvance:milvance@localhost:5432/milvance
PORT=3001
INDEXER_START_LEDGER=4760607
# Seconds between polls when the indexer runs as a long-lived worker
# (`indexer.main.ts watch`). Unused when an external scheduler drives ticks.
INDEXER_POLL_SECONDS=10

# --- Scheduled indexing (free deployment: no always-on worker) ---
# Bearer secret an external scheduler presents to POST /api/internal/indexer/tick.
# UNSET DISABLES THE ENDPOINT — an unauthenticated tick is never the fallback.
# Minimum 32 characters. Server-side only: never NEXT_PUBLIC_*, never logged,
# never committed. In the free deployment Render generates it and Supabase
# Vault stores the copy the cron job presents.
INDEXER_CRON_SECRET=
# How much one tick may do before it stops and reports caughtUp=false. A
# backlog is finished by later ticks; no event is ever skipped to end sooner.
INDEXER_TICK_MAX_PAGES=5
INDEXER_TICK_MAX_EVENTS=500
INDEXER_TICK_MAX_SECONDS=20

# --- Stellar / Soroban: the financial source of truth ---
STELLAR_NETWORK=testnet
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
MILVANCE_CONTRACT_ID=CCN6AZHLN2BQPCDZWXJGA3NRJEJ56V5JK3M4VZ5QFKQ3NSJBN6RVTKRX
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
USDC_ASSET_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA

# --- Anchor / local payments (PKG-07). Anchor is the local-money edge, not a settings page. ---
ANCHOR_HOME_DOMAIN=tr-mock-anchor.fly.dev
ANCHOR_MOCK_MODE=true
# Used to encrypt short-lived SEP-10 session material at rest. Never log a JWT.
ANCHOR_SESSION_ENCRYPTION_KEY=

# --- Evidence object storage (PKG-08). Raw documents stay off-chain; only SHA-256 goes on-chain. ---
EVIDENCE_STORAGE_DRIVER=local-dev
EVIDENCE_LOCAL_DIR=.evidence-store
EVIDENCE_MAX_BYTES=26214400
# Production uses `s3` against any S3-compatible bucket (AWS S3, Cloudflare R2,
# MinIO, Supabase Storage). The bucket must be PRIVATE: retrieval goes through
# the API, which is the only place these credentials exist. Setting the driver
# to `s3` without all five values below makes the process refuse to start,
# rather than fail on the first upload mid-demo.
#
# Supabase Storage endpoints carry a path, not just an origin:
#   https://<project-ref>.storage.supabase.co/storage/v1/s3
# and require the project's real region. Supabase S3 access keys can bypass
# Storage RLS, so treat them as full server credentials.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
# R2 ignores the region but still requires one in the signature. Supabase does
# not ignore it: use the project's region, e.g. eu-central-1.
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# --- Public traction dashboard (PKG-11) ---
PUBLIC_METRICS_ENABLED=true

# --- Frontend-safe values only (NEXT_PUBLIC_* is shipped to the browser) ---
# The browser talks to the Anchor directly, so the home domain must be readable
# here. Every endpoint is discovered from its stellar.toml at runtime.
NEXT_PUBLIC_ANCHOR_HOME_DOMAIN=tr-mock-anchor.fly.dev
# Sandbox bank-transfer simulator. Leave unset/false for anything but the
# hackathon sandbox: a production Anchor has no such endpoint.
NEXT_PUBLIC_ANCHOR_MOCK_MODE=true
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_MILVANCE_CONTRACT_ID=CCN6AZHLN2BQPCDZWXJGA3NRJEJ56V5JK3M4VZ5QFKQ3NSJBN6RVTKRX
# The origin Trade Lab invite links and QR codes point at. REQUIRED in a public
# deployment: unset, links carry the browser's own origin, and a localhost link
# in a QR code resolves to the phone that scanned it. Must be a plain http(s)
# origin; anything else is ignored in favour of the browser's own.
# NEXT_PUBLIC_TRADE_LAB_ORIGIN=https://your-milvance-deployment.example

# ============================================================================
# Which variables are secret
#
# SERVER-ONLY, never in a browser bundle and never prefixed NEXT_PUBLIC_:
#   DATABASE_URL, INDEXER_CRON_SECRET, OBJECT_STORAGE_ACCESS_KEY,
#   OBJECT_STORAGE_SECRET_KEY, ANCHOR_SESSION_ENCRYPTION_KEY
#
# PUBLIC by design — these are addresses and URLs, not credentials:
#   every NEXT_PUBLIC_* value, the contract id, the USDC issuer and SAC,
#   the Anchor home domain, the RPC and Horizon URLs.
#
# There is deliberately NO signing key anywhere in this file. The backend has
# nothing to sign with: users authorize every financial action in their own
# wallet.
# ============================================================================
